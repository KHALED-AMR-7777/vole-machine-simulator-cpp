@startuml
title Vole Machine Simulator - Simple Initial Design

class Menu {
  + run()
}

class Machine {
  + loadProgram(file, startAddress)
  + setRegister(index, value)
  + setMemory(address, value)
  + runAll()
  + runStep()
  + display()
}

class Memory {
  - cells[256]
  + read(address)
  + write(address, value)
  + display()
}

class Registers {
  - regs[16]
  + get(index)
  + set(index, value)
  + display()
}

class CPU {
  - pc
  - ir
  - halted
  + fetch()
  + decode()
  + execute()
  + isValid(instruction)
}

class Screen {
  - output
  + write(value)
  + display()
}

Menu --> Machine
Machine *-- Memory
Machine *-- Registers
Machine *-- CPU
Machine *-- Screen
CPU --> Memory
CPU --> Registers
CPU --> Screen
@enduml
